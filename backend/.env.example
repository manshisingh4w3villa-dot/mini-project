# Public URL of the API, used when provider callback URLs are not set directly.
API_BASE_URL
# Public frontend origin(s), comma-separated when both production and preview
# domains are needed. For this deployment, configure the backend's Vercel
# FRONTEND_URL with the production frontend and any preview frontend origins.
FRONTEND_URL

# Secret Vercel Cron Jobs sends as a Bearer token to the production cleanup endpoint.
# Configure a random value in the backend Vercel project's Production environment.
CRON_SECRET=

# Register the Google callback URL for each deployed backend in Google Cloud
# Console > APIs & Services > Credentials > OAuth 2.0 Client ID >
# Authorized redirect URIs. It must exactly match:
# https://<backend-host>/api/auth/google/callback
# For local development:
# http://localhost:3000/api/auth/google/callback
# http://localhost:3000/api/auth/facebook/callback
# Set GOOGLE_CALLBACK_URL only when intentionally overriding this URL.
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Use an active Graph API version for your Facebook app.
FACEBOOK_GRAPH_API_VERSION=v20.0

# Optional overrides, useful when the API is behind a proxy.
# GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
# FACEBOOK_CALLBACK_URL=https://api.example.com/api/auth/facebook/callback

# Email verification. In production, EMAIL_FROM must use a domain verified in
# Resend. The default onboarding sender is restricted to Resend test delivery.
RESEND_API_KEY=
EMAIL_FROM=

# Enable Places API (New) and use a server-restricted API key.
GOOGLE_MAPS_API_KEY=
