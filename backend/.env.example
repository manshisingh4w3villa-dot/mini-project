# Public URL of the API, used when provider callback URLs are not set directly.
API_BASE_URL
# Additional public frontend origin(s), comma-separated when preview domains
# are needed. https://mini-projectfrontend.vercel.app is allowed by default.
FRONTEND_URL

# Create matching OAuth applications and register these callback URLs:
# http://localhost:3000/api/auth/google/callback
# http://localhost:3000/api/auth/facebook/callback
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Use an active Graph API version for your Facebook app.
FACEBOOK_GRAPH_API_VERSION=v20.0

# Optional overrides, useful when the API is behind a proxy.
# GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
# FACEBOOK_CALLBACK_URL=https://api.example.com/api/auth/facebook/callback

# Email verification. In production, EMAIL_FROM must use a domain verified in
# Resend. The default onboarding sender is restricted to Resend test delivery.
RESEND_API_KEY=
EMAIL_FROM=

# Enable Places API (New) and use a server-restricted API key.
GOOGLE_MAPS_API_KEY=
